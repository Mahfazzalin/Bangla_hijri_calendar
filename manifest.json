{
  "manifest_version": 3,
  "name": "Bangla & Hijri Calendar",
  "version": "2.0",
  "description": "বাংলাদেশের প্রমিত বাংলা ও হিজরি ক্যালেন্ডার, নামাজের সময়সূচি, ইতিহাস ও ইভেন্ট রিমাইন্ডার।",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}